<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: aceleași reguli ca în backup_rules.xml, pentru backup-ul în
     cloud și pentru transferul direct pe un telefon nou. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="LicensePrefs.xml" />
        <exclude domain="sharedpref" path="BackupPrefs.xml" />
        <exclude domain="sharedpref" path="SyncQueue.xml" />
        <exclude domain="sharedpref" path="ClientBookingPrefs.xml" />
        <exclude domain="file" path="before_restore.orgbackup" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="LicensePrefs.xml" />
        <exclude domain="sharedpref" path="BackupPrefs.xml" />
        <exclude domain="sharedpref" path="SyncQueue.xml" />
        <exclude domain="sharedpref" path="ClientBookingPrefs.xml" />
        <exclude domain="file" path="before_restore.orgbackup" />
    </device-transfer>
</data-extraction-rules>
